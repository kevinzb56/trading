TAVILY_API_KEY=

# ── LLM Backend selector ──────────────────────────────────────────────────────
# Options: azure | openai | ollama
# azure  → uses AZURE_OPENAI_* vars below (current default)
# openai → uses OPENAI_API_KEY + LLM_MODEL (e.g. gpt-4.1, o3-mini)
# ollama → uses LLM_MODEL + LLM_OLLAMA_BASE_URL (local open-source models)
LLM_BACKEND=

# ── Azure OpenAI (LLM_BACKEND=azure) ─────────────────────────────────────────
AZURE_OPENAI_ENABLED=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_MAX_TOKENS=
AZURE_OPENAI_TEMPERATURE=

# ── Standard OpenAI API (LLM_BACKEND=openai) ─────────────────────────────────
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4.1          # or o3-mini, gpt-4o, etc.

# ── Local Ollama (LLM_BACKEND=ollama) ────────────────────────────────────────
# Run: ollama pull llama3.1:70b  then  ollama serve
# LLM_MODEL=llama3.1:70b         # or qwen2.5:72b, mistral, phi4, etc.
# LLM_OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Tavily (required for both Layer 4 and Layer 7) ───────────────────────────
LLM_USE_TAVILY=
